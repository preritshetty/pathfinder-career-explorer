# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_ai_studio_api_key
# gemini-3.5-flash-lite is the default; choose a model enabled for your account
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional alternate used only when the primary model returns temporary overload.
# Set this to an empty value to disable availability fallback.
GEMINI_FALLBACK_MODEL=
PORT=3001
